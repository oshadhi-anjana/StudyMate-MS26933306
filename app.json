{
  "expo": {
    "name": "StudyMate",
    "slug": "studymate-ms26933306",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/studymate-logo.png",
    "scheme": "studymate",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studymate.ms26933306",
      "icon": "./assets/images/studymate-logo.png"
    },
    "android": {
      "package": "com.studymate.ms26933306",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/studymate-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/studymate-logo.png",
      "name": "StudyMate"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#104D40",
          "image": "./assets/images/studymate-logo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to attach to your study notes.",
          "cameraPermission": "Photograph handwritten notes and assignment instructions.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176B58"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
